  sentences:
  - speakerName: Oracle
    text: My calculations... were... wrong?
    voiceOver: {fileID: 8300000, guid: cc4e9a8a28b3545ed991d7ae256d99c0, type: 3}
    avatar: {fileID: 21300000, guid: cf10ac0df268d4da5b01bcf7dad622c2, type: 3}
  - speakerName: Oracle
    text: Free will... was not... a glitch...
    voiceOver: {fileID: 8300000, guid: b49dfbb239313488095b7006a9bd0ce1, type: 3}
    avatar: {fileID: 21300000, guid: cf10ac0df268d4da5b01bcf7dad622c2, type: 3}
  - speakerName: Oracle
    text: It was... the... answer...
    voiceOver: {fileID: 8300000, guid: 7fab12a9dbcda411f8ce87de1740fe52, type: 3}
