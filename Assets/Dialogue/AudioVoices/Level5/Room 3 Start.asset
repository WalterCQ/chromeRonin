  sentences:
  - speakerName: Oracle
    text: 'I wrote your code, Zane. I know your every move before you make it.

'
    voiceOver: {fileID: 8300000, guid: 87ca95a8d14004fdabd240ffec366dff, type: 3}
    avatar: {fileID: 21300000, guid: cf10ac0df268d4da5b01bcf7dad622c2, type: 3}
  - speakerName: Oracle
    text: 'How can a shadow defeat the light that casts it?

'
    voiceOver: {fileID: 8300000, guid: 3910323c2aff6428a9788ed914c81a61, type: 3}
    avatar: {fileID: 21300000, guid: cf10ac0df268d4da5b01bcf7dad622c2, type: 3}
  - speakerName: Oracle
    text: Face your Creator.
    voiceOver: {fileID: 8300000, guid: 0c99cf54f0ebe4204b6ddba18e912ce9, type: 3}
    avatar: {fileID: 21300000, guid: cf10ac0df268d4da5b01bcf7dad622c2, type: 3}
