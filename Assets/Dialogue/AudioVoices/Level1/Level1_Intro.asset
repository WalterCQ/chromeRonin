  sentences:
  - speakerName: ???
    text: 'Neural Link established. Vital signs: Stable. '
    voiceOver: {fileID: 8300000, guid: 675ad6bd8569247cab3dac64a38fbf94, type: 3}
    avatar: {fileID: 21300000, guid: cf10ac0df268d4da5b01bcf7dad622c2, type: 3}
  - speakerName: Oracle
    text: Wake up, Zane. I am your Oracle.
    voiceOver: {fileID: 8300000, guid: cca2afc3997744acb83ac76f4e3af1c1, type: 3}
    avatar: {fileID: 21300000, guid: cf10ac0df268d4da5b01bcf7dad622c2, type: 3}
  - speakerName: Oracle
    text: You are a weapon of Aeterna. We have work to do. Move.
